# 首次部署先复制本文件为 .env，并按实际部署填写管理员账号和强密码。
# .env 已被 .gitignore 忽略，真实账号密码和 JWT 密钥不要提交到公开仓库。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 不要使用 `infinite-canvas` 作为密码，容器会拒绝启动。
# ADMIN_PASSWORD 留空时，首次启动会生成随机密码并保存到 data/admin-password.txt；
# 填写自定义密码后，每次启动都会按 .env 同步管理员账号。
JWT_SECRET=
# JWT_SECRET 留空时自动生成并保存到 data/jwt-secret.txt，重启后登录状态保持有效。
JWT_EXPIRE_HOURS=168
STORAGE_DRIVER=sqlite
DATABASE_DSN=data/infinite-canvas.db
# Docker Compose 会在容器内覆盖为 /app/data/infinite-canvas.db；此值主要用于本地 go run .
# 修改 .env 后需要重新创建容器：
# docker compose up -d --force-recreate
